# Template, untested. Copy to /etc/udev/rules.d/. The S3 Adapter (host_usb) is 303a:4002, serial PLUMCEC0001.
SUBSYSTEM=="tty", KERNEL=="ttyACM[0-9]*", ATTRS{idVendor}=="303a", ATTRS{idProduct}=="4002", ATTRS{serial}=="PLUMCEC0001", ACTION=="add", TAG+="systemd", ENV{SYSTEMD_WANTS}+="cec-adapter-inputattach@%k.service"
